{
  "id": "select-size-and-add-to-bag",
  "testPlanId": "3e3917a5-2d52-4321-be5f-629da671a609",
  "requirementId": "61b902a5-ec5c-48ef-aa70-1c2d2c9e05e1",
  "suiteName": "Product Listing & Add to Bag - Myntra Men’s T-Shirts",
  "case": {
    "id": "select-size-and-add-to-bag",
    "title": "User can select size and add product to bag",
    "priority": "P0",
    "platforms": [
      "chrome",
      "firefox",
      "safari",
      "edge"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "open-myntra-home",
        "action": "openUrl",
        "targetDescription": "Open Myntra homepage",
        "value": "https://www.myntra.com/"
      },
      {
        "id": "navigate-mens-category",
        "action": "hover",
        "targetDescription": "Hover over 'Men' in main navigation",
        "locatorHint": "nav[role='navigation'] a[title='Men']"
      },
      {
        "id": "select-tshirts-category",
        "action": "tap",
        "targetDescription": "Click on 'T-Shirts' under Men’s category",
        "locatorHint": "a[href*='/men-tshirts']"
      },
      {
        "id": "click-first-product",
        "action": "tap",
        "targetDescription": "Click on first product in listing",
        "locatorHint": ".results-base .product-base:nth-child(1)"
      },
      {
        "id": "select-size",
        "action": "tap",
        "targetDescription": "Select available size (e.g., M)",
        "locatorHint": ".size-buttons-size-button:not(.disabled):nth-child(1)"
      },
      {
        "id": "add-to-bag",
        "action": "tap",
        "targetDescription": "Click 'Add to Bag' button",
        "locatorHint": ".pdp-add-to-bag"
      },
      {
        "id": "assert-add-confirmation",
        "action": "assertVisible",
        "targetDescription": "Assert confirmation that item is added to bag",
        "locatorHint": ".pdp-add-to-bag .added-to-bag"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
